# Pull the base lightweight Alpine Linux OS layer to build upon
FROM alpine:3.18

# 1. Accept the build-time argument
ARG BUILD_VERSION

# 2. Intentionally do NOT pass it into an ENV variable.
ENV LIVE_VERSION=""

# 3. Print the text using an explicit compliance shell array to safely process variables
CMD ["sh", "-c", "echo \"Running in: Production (Build Ver: ${LIVE_VERSION})\""]
