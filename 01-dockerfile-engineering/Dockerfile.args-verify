# Pull the base lightweight Alpine Linux OS layer to build upon
FROM alpine:3.18

# 1. Accept the build-time argument
ARG BUILD_VERSION

# 2. Bake the secret/version into a static file during build time
RUN echo "Config baked into file: ${BUILD_VERSION}" > /etc/app_version

# 3. Ensure the runtime environment variable environment stays blank
ENV BUILD_VERSION=""

# 4. Use an explicit compliance shell array to chain and view both states safely side-by-side
CMD ["sh", "-c", "cat /etc/app_version && echo \"Live Environment variable: [${BUILD_VERSION}]\""]
